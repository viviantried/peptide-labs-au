{
  "functions": {
    "api/order.js": {
      "maxDuration": 60
    },
    "api/giveaway.js": {
      "maxDuration": 60
    },
    "api/public.js": {
      "maxDuration": 60
    }
  },
  "redirects": [
    {
      "source": "/quality-testing",
      "destination": "/shop",
      "permanent": true
    },
    {
      "source": "/education",
      "destination": "/reconstitution",
      "permanent": true
    },
    {
      "source": "/collections/all",
      "destination": "/shop",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/api/bank-details",
      "destination": "/api/public?route=bank-details"
    },
    {
      "source": "/api/inventory",
      "destination": "/api/public?route=inventory"
    },
    {
      "source": "/api/commas-status",
      "destination": "/api/public?route=commas-status"
    },
    {
      "source": "/api/commas-checkout",
      "destination": "/api/public?route=commas-checkout"
    },
    {
      "source": "/card-checkout",
      "destination": "/card-checkout.html"
    },
    {
      "source": "/admin",
      "destination": "/admin.html"
    },
    {
      "source": "/cart",
      "destination": "/seo-pages/page-1.html"
