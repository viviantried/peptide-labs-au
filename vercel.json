  "buildCommand": "node --test tests/checkout-currency.test.js && node scripts/build-seo.mjs",
  "outputDirectory": "public",
  "headers": [
    {
      "source": "/admin",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/card-checkout",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/card-checkout.html",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    },
    {
      "source": "/cart",
